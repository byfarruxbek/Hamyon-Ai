TELEGRAM_BOT_TOKEN=put_your_telegram_token_here
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
# Provider-supported audio transcription model; empty disables voice processing.
AI_TRANSCRIBE_MODEL=
# Optional legacy OpenAI configuration; leave empty when using OpenRouter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
DATABASE_URL=sqlite+aiosqlite:///./data/hamyon.db
TIMEZONE=Asia/Tashkent
RATE_LIMIT_PER_MINUTE=20
MONTHLY_SPENDING_LIMIT_UZS=0
REMINDER_HOUR=9
ENGAGEMENT_NUDGE_HOUR=19
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change_me_before_docker
